{% macro logical_connective_expansion(block) -%}
{% for r in block.rules %}{% if r.rules is defined %}({{ logical_connective_expansion(r) }}){% else %}({{ validation_term(r) }}){% if not loop.last %} {{ block.op }} {% endif %}{% endif %}{% if r.rules is defined and not loop.last%} {{ block.op }} {% endif %}{% endfor %}{%- endmacro -%}

{% macro validation_term(r) -%}
{%if r.switch_field is none %}{% set value_for = 'self'%}{%elif '.' in r.switch_field%}{% set value_for = 'self._root_node.by_ref("' + r.switch_field + '")' %}{%else%}{% set value_for = 'self["' + r.switch_field + '"]'%}{%endif%}{{value_for}}{{r.switch_method_call}} {{r.operand}} {{r.switch_value}}{%- endmacro -%}

{% if document_header %}
#
# This code is generated by builder/build_schema.py and builder/README.md
#
from schema import SchemaValidationException
from schema.fields import (
    BooleanField,
    EnumField,
    DynamicEnumField,
    EnumOption,
    RepeatedField,
    SelectFilter,
    SchemaNodeField,
    StringField,
)
from schema.node import SchemaNode, sub_class_search
{% elif document_footer %}

# all classes declared here as a convenience for the override :func:`schema_fusion`
all_schema_node_classes = sub_class_search(SchemaNode)

{% else %}
class {{ class_name }}(SchemaNode):
    {% if ref %}_ref = "{{ ref }}"{% endif %}
    {% if display %}_display = "{{ display }}"{% endif %}
    {% if description %}_description = "{{ description }}"{% endif %}

    {% for field_name, field_instance in schema_fields %}{{ field_name }} = {{ field_instance.__repr__() }}
    {% endfor %}

    {% if validation_rules %}
    def valid_node(self):
        super().valid_node()
        reasons = []

        {% for r in validation_rules %}
        {% if r.__class__.__name__ == 'ApplicationTypeRule' %}
        app_types = set(self._root_node.by_ref("submission-details.application-types"))
        if {{r.app_type_match}}.issubset(app_types) and self.is_empty_field("{{r.switch_field}}"):
            reasons.append({{r.rule_message}})
        {% else %}
        if {{ logical_connective_expansion(r) }}:
            {% if r.rule_message.startswith('f"') or r.rule_message.startswith("f'") %}
            {# builder considers this safe to render as f-string #}
            reasons.append({{r.rule_message}})
            {% else %}
            reasons.append("{{r.rule_message}}")
            {% endif %}
        {% endif %}
        {% endfor %}
        if reasons:
            raise SchemaValidationException(reasons, node_path=self.node_path)
    {% endif %}

    {% if out_of_scope_rules %}
    @property
    def out_of_scope_fields(self):
        de_scoped = super().out_of_scope_fields
        app_types = set(self._root_node.by_ref("submission-details.application-types"))
        
        {% for app_rule, other_rule in out_of_scope_rules %}
        {% if other_rule is none %}if app_types.isdisjoint({{app_rule.app_type_match}}):{% else %}if not (not app_types.isdisjoint({{app_rule.app_type_match}}){% if other_rule %}and  {{validation_term(other_rule)}}{% endif %}):	{% endif %}
        	    de_scoped.add("{{app_rule.switch_field}}")
		{%endfor%}

        return de_scoped
    {% endif %}

{% endif %}